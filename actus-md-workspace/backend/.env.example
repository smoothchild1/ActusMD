# ----------------------------------------
# 1. LOCAL SERVER & DATABASE CONFIG
# ----------------------------------------
PORT=3001
# URL for your local Postgres database (Homebrew postgresql@16, local dev)
DATABASE_URL="postgresql://<your-mac-username>@localhost:5432/actusmd_dev?schema=public"

# Field-level encryption key for PHI columns (prisma-field-encryption).
# Generate with `npx cloak generate`. Rotate for production and store in a
# secrets manager (Azure Key Vault) rather than a .env file.
PRISMA_FIELD_ENCRYPTION_KEY="k1.aesgcm256.<generate-your-own>"

# Local Azurite Blob Storage emulator (Tier 1 raw artifact storage). This is
# Azurite's well-known default dev account, not a secret.
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;"
AZURE_STORAGE_CONTAINER_NAME="clinical-artifacts"

# Comma-separated list of allowed CORS origins, or leave unset for "*"
CORS_ORIGIN=

# ----------------------------------------
# 2. AZURE SECRETS (OpenAI + Speech)
# ----------------------------------------
# Azure OpenAI / Azure AI Speech keys are NOT set here. Copy
# `azure_stt_openai.env.template` to `azure_stt_openai.env` (gitignored) and
# fill those in - `src/loadEnv.ts` loads that file explicitly.
