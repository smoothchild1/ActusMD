# ----------------------------------------
# 1. LOCAL SERVER & DATABASE CONFIG
# ----------------------------------------
PORT=3001
# URL for your local SQLite database
DATABASE_URL="file:./dev.db"

# Comma-separated list of allowed CORS origins, or leave unset for "*"
CORS_ORIGIN=

# ----------------------------------------
# 2. AZURE OPENAI CONFIG (For Clinical Notes & Multimodal)
# ----------------------------------------
AZURE_OPENAI_API_KEY="<your-azure-openai-key>"
AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com/"
AZURE_OPENAI_API_VERSION="2024-06-01"
# The custom name you gave your GPT-4o (multimodal) deployment in Azure AI Studio
AZURE_OPENAI_DEPLOYMENT_NAME="<your-deployment-name>"

# ----------------------------------------
# 3. AZURE AI SPEECH CONFIG (For Ambient Dictation)
# ----------------------------------------
SPEECH_KEY="<your-speech-key>"
SPEECH_REGION="eastus"
# BCP-47 language tag for recognition (optional, defaults to en-US)
SPEECH_LANGUAGE="en-US"
