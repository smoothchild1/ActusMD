# ----------------------------------------
# ActusMD frontend (Expo) - public runtime config
# Copy to .env and adjust for your machine. Only EXPO_PUBLIC_* vars are
# exposed to the app bundle; never put secrets here.
# ----------------------------------------

# Base URL of the local backend (Express HTTP + Socket.io). The backend
# listens on port 3001 by default.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Mock clinician id sent during the Socket.io handshake for the local pilot.
EXPO_PUBLIC_USER_ID=pilot-user-001
